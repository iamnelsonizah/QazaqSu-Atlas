# ---------- Basemap (pick ONE; with none set the app falls back to free OSM / Esri raster tiles) ----------
# Any MapLibre style JSON URL (Protomaps self-hosted/API style, your own MapTiler style, etc.). Highest priority.
NEXT_PUBLIC_CUSTOM_STYLE_URL=
# MapTiler: https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=
# Stadia Maps: https://client.stadiamaps.com/
NEXT_PUBLIC_STADIA_KEY=

# ---------- HydroSHEDS PMTiles overlays (local archives are used by default) ----------
# Override with a full https:// URL or another /data/file.pmtiles path if needed.
NEXT_PUBLIC_HYDRORIVERS_PMTILES=
NEXT_PUBLIC_HYDROLAKES_PMTILES=
NEXT_PUBLIC_HYDROBASINS_PMTILES=
NEXT_PUBLIC_ROADS_PMTILES=

# ---------- WMS overrides (defaults are best-known endpoints; confirm with GetCapabilities) ----------
NEXT_PUBLIC_GLOFAS_WMS=https://ows.globalfloods.eu/glofas-ows/ows.py
NEXT_PUBLIC_GLOFAS_LAYER=FloodHazard100y
NEXT_PUBLIC_IGRAC_WMS=https://ggis.un-igrac.org/geoserver/ows
NEXT_PUBLIC_IGRAC_LAYER=
NEXT_PUBLIC_WHYMAP_WMS=https://services.bgr.de/wms/grundwasser/whymap/
NEXT_PUBLIC_WHYMAP_LAYER=
